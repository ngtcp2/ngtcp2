prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: libngtcp2_crypto_schannel
Description: Schannel crypto helper library for ngtcp2
Version: @PACKAGE_VERSION@
Requires: libngtcp2 >= @PACKAGE_VERSION@
Libs: -L${libdir} -lngtcp2_crypto_schannel -lsecur32 -lbcrypt
Cflags: -I${includedir}
